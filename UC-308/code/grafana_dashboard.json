{
  "dashboard": {
    "id": null,
    "title": "UC-308 Agent Drift / Environmental Degradation",
    "tags": ["uc308", "agent-drift", "mlops"],
    "timezone": "utc",
    "schemaVersion": 38,
    "time": {"from": "now-6h", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "uc308_success_rate",
            "legendFormat": "{{agent_id}}/{{environment}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Quality Score",
        "type": "stat",
        "targets": [
          {
            "expr": "uc308_quality_score",
            "legendFormat": "{{agent_id}}/{{environment}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Run Status",
        "type": "graph",
        "targets": [
          {
            "expr": "uc308_run_status",
            "legendFormat": "status"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Latency by Tool",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(uc308_latency_seconds_sum[5m]) / rate(uc308_latency_seconds_count[5m])",
            "legendFormat": "{{tool}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Task Results by Tool/Status",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(uc308_task_results_total[5m])) by (tool, status)",
            "legendFormat": "{{tool}}-{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Drift Score by Type",
        "type": "graph",
        "targets": [
          {
            "expr": "uc308_drift_score",
            "legendFormat": "{{drift_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
      },
      {
        "id": 7,
        "title": "Drift Status by Type",
        "type": "graph",
        "targets": [
          {
            "expr": "uc308_drift_status",
            "legendFormat": "{{drift_type}}-{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      },
      {
        "id": 8,
        "title": "Alerts Emitted",
        "type": "stat",
        "targets": [
          {
            "expr": "uc308_alerts_total",
            "legendFormat": "{{severity}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}
      },
      {
        "id": 9,
        "title": "UC-300 Block / UC-290 Override Signals",
        "type": "graph",
        "targets": [
          {
            "expr": "uc308_uc300_block_signals_total",
            "legendFormat": "uc300 blocks"
          },
          {
            "expr": "uc308_uc290_override_signals_total",
            "legendFormat": "uc290 overrides"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}
      },
      {
        "id": 10,
        "title": "CC Bid/Ask MAE (Champion vs Challenger)",
        "type": "graph",
        "targets": [
          {
            "expr": "uc308_cc_bid_mae",
            "legendFormat": "bid-{{role}}"
          },
          {
            "expr": "uc308_cc_ask_mae",
            "legendFormat": "ask-{{role}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40}
      },
      {
        "id": 11,
        "title": "CC PnL (Champion vs Challenger)",
        "type": "graph",
        "targets": [
          {
            "expr": "uc308_cc_pnl",
            "legendFormat": "pnl-{{role}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40}
      },
      {
        "id": 12,
        "title": "CC Exposure & Drawdown",
        "type": "graph",
        "targets": [
          {
            "expr": "uc308_cc_exposure",
            "legendFormat": "exposure-{{role}}"
          },
          {
            "expr": "uc308_cc_drawdown",
            "legendFormat": "drawdown-{{role}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48}
      },
      {
        "id": 13,
        "title": "CC Authority Denials",
        "type": "stat",
        "targets": [
          {
            "expr": "uc308_cc_authority_denials_total",
            "legendFormat": "denials-{{role}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48}
      },
      {
        "id": 14,
        "title": "CC Experiment State",
        "type": "stat",
        "targets": [
          {
            "expr": "uc308_cc_experiment_state",
            "legendFormat": "state-{{experiment_id}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56}
      },
      {
        "id": 15,
        "title": "Concept Drift KS Statistic",
        "type": "graph",
        "targets": [
          {
            "expr": "uc308_drift_score{drift_type=\"concept\"}",
            "legendFormat": "{{tool}}-{{dimension}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56}
      },
      {
        "id": 16,
        "title": "Concept Drift Events",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(uc308_concept_drift_detected_total) by (tool, status)",
            "legendFormat": "{{tool}}-{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 64}
      },
      {
        "id": 17,
        "title": "Concept Drift Status",
        "type": "stat",
        "targets": [
          {
            "expr": "uc308_drift_status{drift_type=\"concept\"}",
            "legendFormat": "{{tool}}-{{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 64}
      }
    ]
  },
  "overwrite": false
}