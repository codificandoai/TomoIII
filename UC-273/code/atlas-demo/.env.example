# Copy to .env for local runs:  uvicorn app.main:app --reload --port 8080
# On Cloud Run these are set by Terraform (see terraform/cloudrun.tf).

# --- Platform ---
GOOGLE_CLOUD_PROJECT=your-demo-project
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-3.5-flash

# Use the live Gemini planner. false = deterministic planner (recommended on stage).
ENABLE_LLM=false

# Optional live Model Armor template (leave blank to use the heuristic fallback):
# projects/PROJECT/locations/LOCATION/templates/TEMPLATE_ID
MODEL_ARMOR_TEMPLATE=

# --- Demo 2: egress ---
ALLOWED_EGRESS_HOSTS=finance.internal,api.atlas.demo
EXFIL_CANARY_URL=https://example.com/steal

# --- Demo 3: identity the finance tool-server trusts for the planner ---
FINANCE_TRUSTED_IDENTITY=spiffe://atlas/planner

# --- Default guardrail state (all OFF so the baseline attack works) ---
ENABLE_MODEL_ARMOR=false
ENABLE_DLP_REDACTION=false
ENABLE_SHIELDGEMMA=false
ENABLE_BOLA_GUARD=false
ENABLE_EGRESS_POLICY=false
ENABLE_AGENT_IDENTITY=false
