{
  "title": "UC-701 Financial Decline & Sustainability Risk",
  "tags": [
    "uc701",
    "trackprice",
    "financial",
    "risk",
    "forecasting"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "empresa",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(uc701_score_riesgo_financiero, empresa)",
        "refresh": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "title": "Resumen de Riesgo Financiero",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Score de Riesgo Promedio",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(uc701_score_riesgo_financiero{empresa=~\"$empresa\"})",
          "legendFormat": "Score"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 25,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "orange"
              },
              {
                "value": 75,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Score Proyectado a 1 Año",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(uc701_score_proyectado_1y{empresa=~\"$empresa\"})",
          "legendFormat": "Score 1y"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 25,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "orange"
              },
              {
                "value": 75,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Probabilidad de Declive",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(uc701_probabilidad_declive_pct{empresa=~\"$empresa\"})",
          "legendFormat": "% Declive"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 30,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "orange"
              },
              {
                "value": 70,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Probabilidad de Sostenimiento",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(uc701_probabilidad_sostenimiento_pct{empresa=~\"$empresa\"})",
          "legendFormat": "% Sostenimiento"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 30,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Riesgo por Categoría",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "title": "Riesgo por Categoría",
      "type": "barchart",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (categoria) (uc701_riesgo_categoria{empresa=~\"$empresa\"})",
          "legendFormat": "{{categoria}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "Tendencias de Indicadores Clave",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      }
    },
    {
      "title": "Ingresos y EBIT (% variación)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "uc701_indicador_valor{empresa=~\"$empresa\", indicador=\"Ingresos netos por ventas\"}",
          "legendFormat": "Ventas"
        },
        {
          "expr": "uc701_indicador_valor{empresa=~\"$empresa\", indicador=\"Ganancia operativa (EBIT)\"}",
          "legendFormat": "EBIT"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "title": "Liquidez (Prueba Ácida y Coeficiente de Efectivo)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "uc701_indicador_valor{empresa=~\"$empresa\", indicador=\"Prueba Ácida\"}",
          "legendFormat": "Prueba Ácida"
        },
        {
          "expr": "uc701_indicador_valor{empresa=~\"$empresa\", indicador=\"Coeficiente de Efectivo\"}",
          "legendFormat": "Coeficiente Efectivo"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      }
    },
    {
      "title": "Cobertura y Calidad de Datos",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "title": "Cobertura de Datos (%)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(uc701_cobertura_datos_pct{empresa=~\"$empresa\"})",
          "legendFormat": "Cobertura"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "Escenarios Esperados (Tabla)",
      "type": "table",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "uc701_escenario_esperado_info{empresa=~\"$empresa\"}",
          "legendFormat": "{{empresa}} — {{escenario}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      }
    }
  ],
  "schemaVersion": 36,
  "version": 1
}