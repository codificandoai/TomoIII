{
  "title": "UC-700 Self-Healing Training Overview",
  "tags": [
    "uc700",
    "self-healing",
    "training",
    "gpu",
    "qbex"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(uc700_anomaly_score, node_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "job",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(uc700_efficiency_pct, job_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "title": "Estado del Sistema de Autosanación",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Incidentes Activos",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(uc700_incident_state{node_id=~\"$node\"})",
          "legendFormat": "Active Incidents"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Score de Anomalía Máximo",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(uc700_anomaly_score{node_id=~\"$node\"})",
          "legendFormat": "Max Anomaly Score"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 0.75,
                "color": "yellow"
              },
              {
                "value": 0.95,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Escalamientos a Operador",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(uc700_escalations_total[1h]))",
          "legendFormat": "Escalations/h"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Eficiencia Promedio Post-Recuperación",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(uc700_efficiency_pct{job_id=~\"$job\"})",
          "legendFormat": "Avg Efficiency %"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 90,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Infraestructura GPU",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "title": "Utilización y VRAM por Nodo",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (node_id) (uc700_device_state{node_id=~\"$node\"}) * 25",
          "legendFormat": "Health Index"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      }
    },
    {
      "title": "Estado de Dispositivos",
      "type": "table",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "uc700_device_state{node_id=~\"$node\"}",
          "legendFormat": "{{node_id}} / {{device_id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      }
    },
    {
      "title": "Pipeline de Autosanación",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      }
    },
    {
      "title": "Incidentes por Severidad y Alcance",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (severity, scope) (rate(uc700_incidents_total[5m]))",
          "legendFormat": "{{severity}} / {{scope}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      }
    },
    {
      "title": "Duración de Remediación por Estrategia",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(uc700_remediation_duration_seconds_bucket[5m])) by (le, strategy))",
          "legendFormat": "{{strategy}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Validación y Eficiencia del Entrenamiento",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "title": "Eficiencia por Job",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "uc700_efficiency_pct{job_id=~\"$job\"}",
          "legendFormat": "{{job_id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 90,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Validaciones Exitosas vs Fallidas",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (check) (rate(uc700_validation_checks_total{result=\"pass\"}[5m]))",
          "legendFormat": "pass {{check}}"
        },
        {
          "expr": "sum by (check) (rate(uc700_validation_checks_total{result=\"fail\"}[5m]))",
          "legendFormat": "fail {{check}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      }
    },
    {
      "title": "Logs y Auditoría",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      }
    },
    {
      "title": "Logs del Orquestador de Autosanación",
      "type": "logs",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{app=\"uc700-self-healing\"} |= `INC` or `remediation` or `escalation` | json",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ],
  "schemaVersion": 36,
  "version": 1
}