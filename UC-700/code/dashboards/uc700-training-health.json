{
  "title": "UC-700 Training Health & Checkpoints",
  "tags": [
    "uc700",
    "training",
    "checkpoints",
    "qbex"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(uc700_anomaly_score, node_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "job",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(uc700_efficiency_pct, job_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "title": "Salud del Entrenamiento",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Samples por Segundo",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (node_id) (DCGM_FI_DEV_GPU_UTIL{node_id=~\"$node\"}) * 1000",
          "legendFormat": "{{node_id}} samples/s proxy"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "title": "Tiempo por Paso (ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (job_id) (uc700_training_step_time_ms{job_id=~\"$job\"})",
          "legendFormat": "{{job_id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "title": "Checkpoints",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "title": "Edad del Último Checkpoint (s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg by (job_id) (uc700_checkpoint_age_seconds{job_id=~\"$job\"})",
          "legendFormat": "{{job_id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1800,
                "color": "red"
              }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 36,
  "version": 1
}